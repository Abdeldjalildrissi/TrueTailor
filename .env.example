# Copy to .env and fill in values. Never commit .env — it is gitignored.

# Absolute base URL of this deployment. Drives secure-cookie behavior and origin checks.
APP_URL=http://localhost:3000

# SQLite database file. In production this must point at a persistent mounted volume.
DATABASE_PATH=./data/app.db

# Runtime AI provider for structured extraction and tailoring:
# "anthropic" (default), "openai", "google" (Gemini), or "openrouter".
AI_PROVIDER=anthropic
# Optional model override; sensible per-provider defaults are built in.
# Leave commented to use the default for AI_PROVIDER.
# AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
